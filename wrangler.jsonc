{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ta-falado",
  "compatibility_date": "2026-11-04",
  // The site is fully static (Astro's build output). This Worker only answers byte ranges
  // for MP3s, which static assets don't (ADR 0002).
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /mp3/* invokes the Worker; every other path stays a free static-asset request.
    "run_worker_first": ["/mp3/*"]
  },
  // Workers Builds runs `wrangler preview` for non-production branches, which needs this block.
  "previews": {}
}
