---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import FinishedMark from '../../components/FinishedMark.astro';
import PlayButton from '../../components/PlayButton.astro';
import Base from '../../layouts/Base.astro';
import { formatDate, formatDuration, isoDate, isoDuration } from '../../lib/format';
import { getLessons, lessonPath, type Lesson } from '../../lib/lessons';
import { SERIES_LABEL } from '../../lib/series';

export const getStaticPaths = (async () => {
  const lessons = await getLessons();
  return lessons.map((lesson) => {
    const [, series, number] = lessonPath(lesson.data).split('/');
    return { params: { series, number }, props: { lesson } };
  });
}) satisfies GetStaticPaths;

const { lesson } = Astro.props as { lesson: Lesson };
const { data } = lesson;
const { Content } = await render(lesson);
const heading = `${SERIES_LABEL[data.series]} ${data.number}`;
---

<Base title={`${heading}: ${data.title}`}>
  <article>
    <hgroup>
      <p>{heading} <FinishedMark id={lessonPath(data)} /></p>
      <h1>{data.title}</h1>
      {data.topic && <p>{data.topic}</p>}
    </hgroup>
    <p>
      Originally published <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>{" · "}
      <time datetime={isoDuration(data.audio.durationSeconds)}>
        {formatDuration(data.audio.durationSeconds)}
      </time>
    </p>
    <p><PlayButton lesson={lesson} /></p>
    {data.photo && <img src={data.photo.url} alt={data.photo.alt} loading="lazy" decoding="async" />}
    <Content />
    <p><a href={data.pdf.url}>Transcript (PDF)</a></p>
  </article>
</Base>
