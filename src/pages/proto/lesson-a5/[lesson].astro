---
// PROTOTYPE (#55) variant A5, "Screen-print banner": the photo runs edge to edge across the top
// of the pane, printed in two colours (black on ipê) under a fine dot screen. The print look is
// what lets a ~225px photo go this big: the dots hide the softness. A's header then sits on a
// white tab that overlaps the banner's foot. No photo (Supplementary): the bare ipê dot field.
import Base from '../../../layouts/Base.astro';
import Switcher from '../_Switcher.astro';
import Parts from '../_AParts.astro';
import { sampleStaticPaths, view } from '../_lesson';
import '../_a-family.css';

export const getStaticPaths = sampleStaticPaths;
const { lesson } = Astro.props;
const v = view(lesson);
---

<Base title={`${v.series} ${v.number}: ${v.title}`} noindex>
  <article class="af a5" data-proto-lesson={v.trackJson}>
    <div class="banner">
      {v.photo && <img src={v.photo.url} alt={v.photo.alt} />}
    </div>
    <header>
      <p class="af-series">{v.series} {v.number}</p>
      <h1 class="af-title">{v.title}</h1>
      <p class="af-facts">
        First published <time datetime={v.isoDate}>{v.date}</time>. {v.minutes} of audio.
        {v.topic && <> Culture talk: {v.topic}.</>}
      </p>
      <Parts part="play" v={v} />
    </header>
    <div class="body"><Parts part="body" v={v} /></div>
  </article>
  <Switcher variant="a5" lesson={lesson.id} />
</Base>

<script>
  import '../_play';
</script>

<style>
  .a5 {
    --bleed-x: 20px;
    --bleed-y: var(--space-24);
    max-inline-size: none !important;
  }
  .banner {
    position: relative;
    block-size: clamp(170px, 32vw, 280px);
    margin: calc(-1 * var(--bleed-y)) calc(-1 * var(--bleed-x)) 0;
    overflow: hidden;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: var(--ipe);
  }
  .banner img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 35%;
    filter: grayscale(1) contrast(1.35) brightness(1.05);
    mix-blend-mode: multiply;
  }
  /* The dot screen. */
  .banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, var(--ipe) 0.9px, transparent 1.5px) 0 0 / 4px 4px;
    opacity: 0.55;
  }
  header {
    position: relative;
    max-inline-size: 40rem;
    margin-block-start: -56px;
    margin-inline-start: calc(-1 * var(--bleed-x));
    padding: 20px var(--bleed-x) 0;
    border-start-end-radius: var(--radius-card);
    background: var(--surface);
  }
  .body {
    max-inline-size: 44rem;
  }
  @media (min-width: 52rem) {
    .a5 {
      --bleed-x: 48px;
      --bleed-y: 40px;
    }
  }
</style>
