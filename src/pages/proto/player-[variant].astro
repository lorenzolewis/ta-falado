---
// PROTOTYPE (#59), never merged: picks a mini-player variant (src/components/proto/PlayerProto.astro)
// and gives it real lessons to play, real pages to navigate to, and a long page to scroll.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PlayButton from '../../components/PlayButton.astro';
import Base from '../../layouts/Base.astro';
import { formatDuration } from '../../lib/format';
import { getLesson, getLessons, lessonPath, lessonTitle } from '../../lib/lessons';

const NAMES = { a: 'Bar and sheet', b: 'Full deck', c: 'Floating card' } as const;
type Variant = keyof typeof NAMES;

export const getStaticPaths = (() => (['a', 'b', 'c'] as const).map((variant) => ({ params: { variant } }))) satisfies GetStaticPaths;

const variant = Astro.params.variant as Variant;
const lessons = (await getLessons()).filter((_, i) => [0, 7, 24, 40, 44, 45].includes(i));
const long = (await getLesson('grammar', 17))!;
const { Content } = await render(long);
const pitch: Record<Variant, string> = {
  a: 'A slim bar with back 10s and play. On a phone, tap the title to open a full sheet with the cover, seek, forward 30s, speed and mute. On desktop it is one full row and has no sheet.',
  b: 'Every control is always on screen and nothing expands. It also shows before anything is playing, so the player is always in the same place.',
  c: 'A card that floats clear of the edges, with the lesson’s progress as a ring around play. Speed is always there; the arrow opens seek, the jumps and mute in place.',
};
---

<Base title={`Mini-player ${variant.toUpperCase()} (prototype)`} noindex>
  <div class="proto" data-proto-set-variant={variant}>
    <h1>Mini-player {variant.toUpperCase()}: {NAMES[variant]}</h1>
    <p class="lede">{pitch[variant]}</p>
    <p>
      Play a lesson, then open others from the lesson list, Home and About: the audio should carry on. The black bar at
      the top switches variants (or press <kbd>[</kbd> and <kbd>]</kbd>) and forces a state (idle, loading, playing,
      paused, error). Your choice is remembered on this device.
    </p>
    <p class="variants">
      {
        (['a', 'b', 'c'] as const).map((v) => (
          <a href={`/proto/player-${v}`} aria-current={v === variant ? 'page' : undefined}>
            {v.toUpperCase()}: {NAMES[v]}
          </a>
        ))
      }
    </p>

    <h2>Try a lesson</h2>
    <ul class="lessons">
      {
        lessons.map((lesson) => (
          <li>
            <a href={lessonPath(lesson.data)}>{lessonTitle(lesson.data)}</a>
            <span>{formatDuration(lesson.data.audio.durationSeconds)}</span>
            <PlayButton lesson={lesson} />
          </li>
        ))
      }
    </ul>

    <h2>A long page, for scrolling and focus</h2>
    <p>
      Tab through the links below to the end of the page: the focused link should never sit under the player.
    </p>
    <article>
      <Content />
      <p><a href={lessonPath(long.data)}>Open {lessonTitle(long.data)}</a></p>
      <p><a href="/about">About this site</a></p>
    </article>
  </div>
</Base>

<style>
  .proto p {
    margin-block: 0 var(--space-16);
  }
  .lede {
    font-family: var(--font-serif);
    font-size: var(--text-21);
    line-height: 1.45;
  }
  .variants {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }
  .variants a {
    padding: var(--space-8) var(--space-16);
    border: 2px solid var(--accent);
    border-radius: var(--radius-pill);
    font-weight: 700;
    text-decoration: none;
  }
  .variants a[aria-current] {
    background: var(--accent);
    color: var(--on-accent);
  }
  .lessons {
    margin: 0 0 var(--space-32);
    padding: 0;
    list-style: none;
  }
  .lessons li {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--space-12);
    min-block-size: 56px;
    border-block-end: 1px solid var(--line);
  }
  .lessons span {
    color: var(--muted);
    font-size: var(--text-14);
  }
  .lessons :global(button) {
    min-block-size: 44px;
    padding: 0 var(--space-16);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
  }
</style>
