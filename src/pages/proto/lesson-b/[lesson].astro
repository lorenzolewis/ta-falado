---
// PROTOTYPE (#55) variant B, "Listening card": the top of the page is a --strong card, like the
// home page's Continue card, holding the photo, the title and a big round play button with this
// lesson's own progress bar, which moves in step with the mini-player. The intro reads below in
// sans, then the culture topic, then the transcript as a pill button. PT words get an ipê
// underline; ES words are plain italic.
import Icon from '../../../components/Icon.astro';
import Base from '../../../layouts/Base.astro';
import Switcher from '../_Switcher.astro';
import { sampleStaticPaths, view } from '../_lesson';

export const getStaticPaths = sampleStaticPaths;
const { lesson } = Astro.props;
const v = view(lesson);
---

<Base title={`${v.series} ${v.number}: ${v.title}`} noindex>
  <article class="b" data-proto-lesson={v.trackJson}>
    <header class:list={['card', { 'no-photo': !v.photo }]}>
      {v.photo && <img class="photo" src={v.photo.url} alt={v.photo.alt} />}
      <div class="head">
        <p class="series">{v.series} {v.number}</p>
        <h1>{v.title}</h1>
      </div>
      <div class="listen">
        <button type="button" class="play" data-proto-play>
          <Icon name="play" class="i-play" /><Icon name="pause" class="i-pause" />
          <span class="visually-hidden" data-proto-label>Play</span>
        </button>
        <div class="track">
          <span class="meter"><span></span></span>
          <span class="times">
            <span data-proto-left></span>
            <span class="total">{v.duration}</span>
          </span>
        </div>
      </div>
    </header>

    <p class="date">First published <time datetime={v.isoDate}>{v.date}</time></p>
    <div class="intro" set:html={v.intro} />
    {
      v.topic && (
        <p class="topic">
          Culture talk: <strong>{v.topic}</strong>
        </p>
      )
    }
    <p class="pdf">
      <a class="btn" href={v.pdf}><Icon name="doc" />Transcript (PDF{v.pdfSize && `, ${v.pdfSize}`})</a>
    </p>
  </article>
  <Switcher variant="b" lesson={lesson.id} />
</Base>

<script>
  import '../_play';
</script>

<style>
  p {
    margin: 0;
  }
  .card {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: 'photo head' 'listen listen';
    gap: 20px;
    align-items: center;
    padding: 20px;
    border-radius: var(--radius-card);
    background: var(--strong);
    color: var(--on-strong);
  }
  .card.no-photo {
    grid-template-areas: 'head head' 'listen listen';
  }
  .card :focus-visible {
    outline-color: var(--ipe);
  }
  .photo {
    grid-area: photo;
    inline-size: clamp(96px, 28vw, 200px);
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-row);
  }
  .head {
    grid-area: head;
  }
  .series {
    color: var(--on-strong-muted);
    font-weight: 500;
  }
  h1 {
    margin: var(--space-4) 0 0;
    font-size: clamp(var(--text-24), 5vw, var(--text-36));
    line-height: 1.05;
    text-wrap: balance;
  }
  .listen {
    grid-area: listen;
    display: flex;
    align-items: center;
    gap: var(--space-16);
  }
  .play {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 64px;
    block-size: 64px;
    border: 0;
    border-radius: 50%;
    background: var(--ipe);
    color: var(--on-ipe);
  }
  .play :global(.icon) {
    inline-size: 28px;
    block-size: 28px;
  }
  [data-proto-play] :global(.i-pause),
  [data-state='playing'] :global(.i-play),
  [data-state='loading'] :global(.i-play) {
    display: none;
  }
  [data-state='playing'] :global(.i-pause),
  [data-state='loading'] :global(.i-pause) {
    display: block;
  }
  .track {
    flex: 1;
    display: grid;
    gap: var(--space-6);
  }
  .meter {
    display: block;
    block-size: 6px;
    border-radius: var(--radius-pill);
    background: var(--track-on-strong);
  }
  .meter > span {
    display: block;
    block-size: 100%;
    inline-size: calc(var(--done, 0) * 1%);
    border-radius: inherit;
    background: var(--ipe);
  }
  .times {
    display: flex;
    justify-content: space-between;
    color: var(--on-strong-muted);
    font-size: var(--text-14);
    font-variant-numeric: tabular-nums;
  }

  .date {
    margin-block-start: var(--space-24);
    color: var(--muted);
    font-size: var(--text-14);
  }
  .intro {
    max-inline-size: 38rem;
    margin-block-start: var(--space-8);
    font-size: var(--text-18);
    line-height: 1.5;
  }
  .intro :global(.w-pt) {
    text-decoration: underline 3px var(--ipe);
    text-underline-offset: 3px;
  }
  .topic {
    margin-block-start: var(--space-16);
    color: var(--muted);
  }
  .topic strong {
    color: var(--ink);
  }
  .pdf {
    margin-block-start: var(--space-24);
  }
  .pdf .btn {
    border: 2px solid var(--accent);
    color: var(--accent);
  }

  @media (min-width: 52rem) {
    .card {
      grid-template-columns: auto 1fr;
      grid-template-areas: 'photo head' 'photo listen';
      align-items: end;
      padding: var(--space-24);
    }
    .card.no-photo {
      grid-template-areas: 'head head' 'listen listen';
    }
    .photo {
      inline-size: 220px;
    }
  }
</style>
