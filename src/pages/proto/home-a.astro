---
// PROTOTYPE (#53), variant A "Notebook index": the #52 home refined. One centred column; a big
// name, the Continue card, a filter that sticks to the top while scrolling, and numbered lists.
import FinishedMark from '../../components/FinishedMark.astro';
import { ICON } from '../../components/proto/icons';
import { homeData } from '../../components/proto/home-data';
import ProtoHead from '../../components/proto/ProtoHead.astro';
import ProtoSwitcher from '../../components/proto/ProtoSwitcher.astro';
import Base from '../../layouts/Base.astro';

const groups = await homeData();
---

<Base title="Home A (prototype)" noindex bare>
  <ProtoHead slot="head" />
  <div class="va" data-variant="a">
    <header class="top">
      <a class="wordmark" href="/proto/home-a" lang="pt-BR">Tá Falado</a>
      <a class="top-link" href="/about">About</a>
    </header>

    <main id="main">
      <h1 lang="pt-BR">Tá Falado</h1>
      <p class="lede">Brazilian Portuguese pronunciation and grammar lessons for Spanish speakers.</p>

      <section class="continue" aria-labelledby="continue" data-continue hidden>
        <h2 id="continue">Continue where you left off</h2>
        <p class="continue-title"><a data-continue-link href="/"></a></p>
        <div class="bar" data-continue-bar><span></span></div>
        <p class="continue-time" data-continue-time></p>
        <p><button type="button" class="btn" data-continue-play><Fragment set:html={ICON.play} />Resume</button></p>
      </section>

      <search class="filter">
        <label for="lesson-filter">Filter lessons</label>
        <div class="field">
          <Fragment set:html={ICON.search} />
          <input type="search" id="lesson-filter" autocomplete="off" placeholder="nh, ão, ficar…" />
        </div>
        <p class="status" id="lesson-filter-status" role="status"></p>
      </search>

      <div class="empty" data-empty hidden>
        <p>No lessons match “<span data-empty-query></span>”.</p>
        <p class="hint">Try fewer words, a sound like <i lang="pt-BR">nh</i>, or a topic like <i>food</i>.</p>
        <button type="button" class="btn btn-quiet" data-clear>Clear the filter</button>
      </div>

      {
        groups.map((g) => (
          <section class="series" aria-labelledby={`a-${g.id}`} data-series>
            <div class="series-head">
              <h2 id={`a-${g.id}`}>{g.label}</h2>
              <p class="series-count" data-count data-size={g.size}>{g.size} lessons</p>
            </div>
            <ol class="lessons">
              {g.rows.map((r) => (
                <li class="lesson" data-filter-text={r.filterText} data-path={r.path} data-seconds={r.seconds}>
                  <span class="num" aria-hidden="true">{r.number}</span>
                  <span class="text">
                    <a href={r.path}>
                      <span class="visually-hidden">{g.label} {r.number}: </span>
                      {r.title}
                    </a>
                    {r.topic && <span class="topic">{r.topic}</span>}
                  </span>
                  <span class="meta">
                    <time datetime={r.iso}>{r.duration}</time>
                    <span class="done">
                      <FinishedMark id={r.path} />
                    </span>
                  </span>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </main>

    <footer class="foot">
      <p>
        <b>An independent, unofficial archive.</b> The lessons are by COERLL at the University of Texas at Austin, licensed <a
          href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a
        >.
      </p>
      <p class="foot-links"><a href="/about">About this site</a><a href="/feed.xml">Podcast feed</a></p>
    </footer>
  </div>
  <ProtoSwitcher current="a" />
</Base>

<style is:global>
  .va {
    max-inline-size: 40rem;
    margin-inline: auto;
    padding-inline: 16px;
  }
  .va p {
    margin-block: 0;
  }
  .va .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 12px;
  }
  .va .wordmark {
    font: italic 700 1.3125rem/1 var(--serif);
    color: var(--accent);
    text-decoration: none;
    padding-block: 12px;
  }
  .va .top-link {
    font-weight: 500;
    padding: 12px 0 12px 12px;
  }
  .va h1 {
    font: 700 3.75rem/1 var(--serif);
    letter-spacing: -0.01em;
    margin: 16px 0 12px;
  }
  .va .lede {
    font: 1.3125rem/1.45 var(--serif);
    color: var(--muted);
    max-inline-size: 32rem;
  }
  .va .continue {
    margin-block-start: 24px;
    padding: 20px;
    border-radius: 20px;
    background: var(--strong);
    color: var(--on-strong);
    display: grid;
    gap: 8px;
  }
  .va .continue[hidden] {
    display: none;
  }
  .va .continue h2 {
    font-size: 0.875rem;
    font-weight: 500;
    margin: 0;
  }
  .va .continue-title {
    font: 700 1.75rem/1.1 var(--serif);
  }
  .va .continue-title a {
    color: inherit;
    text-decoration: none;
  }
  .va .continue-time {
    font-size: 0.875rem;
  }
  .va .continue-time::first-letter {
    text-transform: uppercase;
  }
  .va .bar {
    block-size: 8px;
    border-radius: 999px;
    background: var(--track-on-strong);
    margin-block-start: 8px;
  }
  .va .bar span {
    display: block;
    block-size: 100%;
    inline-size: var(--p, 0%);
    border-radius: inherit;
    background: var(--ipe);
  }
  .va .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-block-size: 48px;
    padding: 0 22px 0 16px;
    border: 0;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1.125rem;
    background: var(--ipe);
    color: var(--on-ipe);
    cursor: pointer;
    margin-block-start: 6px;
  }
  .va .btn .icon {
    inline-size: 20px;
    block-size: 20px;
  }
  .va .btn-quiet {
    background: transparent;
    color: var(--accent);
    border: 2px solid var(--accent);
    padding-inline: 20px;
  }
  /* The filter sticks to the top, so what you type stays in view as the list shrinks under it. */
  .va .filter {
    position: sticky;
    inset-block-start: 0;
    z-index: 2;
    display: grid;
    gap: 6px;
    margin-block-start: 24px;
    padding-block: 8px;
    background: var(--bg);
  }
  .va .filter label {
    font-weight: 500;
    font-size: 0.875rem;
  }
  .va .field {
    display: flex;
    align-items: center;
    gap: 8px;
    min-block-size: 48px;
    padding-inline: 16px;
    border: 2px solid var(--control);
    border-radius: 999px;
    background: var(--surface);
  }
  .va .field:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .va .field .icon {
    color: var(--muted);
    inline-size: 20px;
    block-size: 20px;
  }
  .va .field input {
    flex: 1;
    min-inline-size: 0;
    border: 0;
    background: transparent;
    outline: none;
    font-size: 1.125rem;
  }
  .va .field input::placeholder {
    color: var(--muted);
  }
  .va .status {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .va .status:empty {
    display: none;
  }
  .va .empty {
    margin-block: 24px;
    display: grid;
    gap: 8px;
    justify-items: start;
  }
  .va .empty[hidden] {
    display: none;
  }
  .va .empty p:first-child {
    font: 700 1.5rem/1.2 var(--serif);
  }
  .va .hint {
    color: var(--muted);
  }
  .va .series[hidden] {
    display: none;
  }
  .va .series-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-block: 32px 4px;
  }
  .va .series h2 {
    font: 700 2.25rem/1 var(--serif);
    margin: 0;
  }
  .va .series-count {
    font-size: 0.875rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .va .lessons {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .va .lesson {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    gap: 10px;
    align-items: center;
    padding-block: 7px;
    border-block-end: 1px solid var(--line);
    min-block-size: 48px;
  }
  .va .lesson[hidden] {
    display: none;
  }
  .va .num {
    font: 700 1.5rem/1 var(--serif);
    color: var(--accent);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .va .text {
    display: grid;
    min-inline-size: 0;
  }
  .va .text a {
    color: var(--ink);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.25;
    text-decoration: none;
  }
  /* The whole row is the link's target. */
  .va .text a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .va .text a:hover {
    text-decoration: underline;
  }
  .va .topic {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .va .meta {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  /* A fixed slot, so durations line up whether or not the lesson is finished. */
  .va .done {
    inline-size: 22px;
    display: grid;
  }
  .va [data-finished]:not([hidden]) {
    display: grid;
    place-items: center;
    inline-size: 22px;
    block-size: 22px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    font-size: 0.8125rem;
  }
  .va .foot {
    margin-block-start: 48px;
    padding-block: 20px 32px;
    border-block-start: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.45;
    display: grid;
    gap: 8px;
  }
  .va .foot b {
    color: var(--ink);
    font-weight: 500;
  }
  .va .foot-links {
    display: flex;
    gap: 20px;
  }
  .va .foot-links a {
    font-weight: 500;
    padding-block: 8px;
  }
</style>

<script>
  import { onPage, showProgress, wireFilter } from '../../components/proto/proto-client';

  onPage((signal) => {
    if (!document.querySelector('[data-variant="a"]')) return;
    showProgress();
    const input = document.querySelector<HTMLInputElement>('#lesson-filter')!;
    const status = document.querySelector<HTMLElement>('#lesson-filter-status')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const sections = [...document.querySelectorAll<HTMLElement>('[data-series]')];
    const run = wireFilter(
      input,
      ({ query, matches, rows }) => {
        rows.forEach((row, i) => (row.hidden = !matches.has(i)));
        for (const s of sections) {
          const shown = s.querySelectorAll('li:not([hidden])').length;
          const count = s.querySelector<HTMLElement>('[data-count]')!;
          count.textContent = query ? `${shown} of ${count.dataset.size}` : `${count.dataset.size} lessons`;
          s.hidden = shown === 0;
        }
        empty.hidden = !query || matches.size > 0;
        empty.querySelector('[data-empty-query]')!.textContent = query;
        status.textContent = !query || !matches.size ? '' : `${matches.size} ${matches.size === 1 ? 'lesson matches' : 'lessons match'}`;
      },
      signal,
    );
    document.querySelector('[data-clear]')!.addEventListener(
      'click',
      () => {
        input.value = '';
        run();
        input.focus();
      },
      { signal },
    );
  });
</script>
