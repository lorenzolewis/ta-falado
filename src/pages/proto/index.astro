---
// PROTOTYPE (#55): links to the chosen lesson page for each sample lesson, for opening on a phone.
import Base from '../../layouts/Base.astro';
import { SAMPLES } from './_lesson';
---

<Base title="Lesson page prototype" noindex>
  <h1>Lesson page prototype (#55)</h1>
  <p>The chosen design (A8, print cover) with each series' paper colour. See PROTOTYPE.md.</p>
  <ul>
    {
      SAMPLES.map((slug) => (
        <li>
          <a href={`/proto/lesson/${slug}`}>{slug}</a>
        </li>
      ))
    }
  </ul>
</Base>
