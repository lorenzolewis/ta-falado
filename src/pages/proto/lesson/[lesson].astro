---
// PROTOTYPE (#55), the chosen lesson page ("A8, print cover"). See PROTOTYPE.md for the specs.
//
// The lesson photo is printed edge to edge across the top of the pane in one ink on a coloured
// paper under a dot screen, framed at 9:7 (the photos average 1.28). The paper colour is the
// series: ipê-amarelo (Pronunciation), ipê-rosa (Grammar), ipê-roxo (Supplementary), the three
// colours the ipê tree flowers in. The series and title sit on the foot of the print over a
// gradient from clear to the page colour. A lesson with no photo gets the same frame with
// "Tá Falado" printed across the top, so the header never changes height between lessons.
import Base from '../../../layouts/Base.astro';
import Parts from '../_AParts.astro';
import { sampleStaticPaths, view } from '../_lesson';
import '../_a-family.css';

export const getStaticPaths = sampleStaticPaths;
const { lesson } = Astro.props;
const v = view(lesson);
---

<Base title={`${v.series} ${v.number}: ${v.title}`} noindex>
  <article class="af lesson" data-proto-lesson={v.trackJson}>
    <header>
      <div class="cover">
        {
          v.photo ? (
            <div class="print" data-series={lesson.data.series}>
              <img src={v.photo.url} alt={v.photo.alt} />
            </div>
          ) : (
            <div class="print placeholder" data-series={lesson.data.series} aria-hidden="true">
              <span lang="pt-BR">Tá Falado</span>
            </div>
          )
        }
        <div class="name">
          <p class="af-series">{v.series} {v.number}</p>
          <h1 class="af-title">{v.title}</h1>
        </div>
      </div>
      <p class="af-facts">
        First published <time datetime={v.isoDate}>{v.date}</time>. {v.minutes} of audio.
        {v.topic && <> Culture talk: {v.topic}.</>}
      </p>
      <Parts part="play" v={v} />
    </header>
    <Parts part="body" v={v} />
  </article>
</Base>

<script>
  import '../_play';
</script>

<style>
  .lesson {
    --bleed-x: 20px;
    --bleed-y: var(--space-24);
    max-inline-size: 44rem;
  }

  /* The print and the title share one grid cell; the title block sits on the print's foot. */
  .cover {
    display: grid;
    margin: calc(-1 * var(--bleed-y)) calc(-1 * var(--bleed-x)) 0;
  }
  .cover > * {
    grid-area: 1 / 1;
  }

  /* Paper and ink are fixed, not theme tokens: a print looks the same in light and dark. */
  .print {
    --paper: #f5c842;
    --ink: #1b1b1b;
    position: relative;
    aspect-ratio: 9 / 7;
    overflow: hidden;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: var(--paper);
  }
  .print[data-series='grammar'] {
    --paper: #f4a6c6;
  }
  .print[data-series='supplementary'] {
    --paper: #bba6ec;
  }
  .print img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.35) brightness(1.05);
    mix-blend-mode: multiply;
  }
  /* The dot screen: paper-coloured dots, 4px apart, over the ink. */
  .print::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, var(--paper) 0.9px, transparent 1.5px) 0 0 / 4px 4px;
    opacity: 0.55;
    pointer-events: none;
  }

  /* No photo: "Tá Falado" in the ink, one line across the top, sized to the frame's width. */
  .placeholder {
    display: grid;
    place-items: start start;
    container-type: inline-size;
  }
  .placeholder span {
    margin: 0.16em 0 0 0.1em;
    color: var(--ink);
    font: 700 18.5cqi / 0.82 var(--font-serif);
    letter-spacing: -0.03em;
    white-space: nowrap;
    mix-blend-mode: multiply;
    opacity: 0.85;
  }

  .name {
    position: relative;
    align-self: end;
    padding: 112px var(--bleed-x) 0;
    /* Clear at the top, the page colour by the series line, so the text always has the page behind it. */
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--surface) 70%, transparent) 45%,
      var(--surface) 80%
    );
  }
  .af-title {
    margin-block-end: 0;
  }
  .af-facts {
    margin-block-start: var(--space-12);
  }

  /* Desktop: edge to edge across the pane, as on the phone. At full pane width 9:7 would be taller
     than the window, so the height is capped and the photo crops wider there. */
  @media (min-width: 52rem) {
    .lesson {
      --bleed-x: 48px;
      --bleed-y: 40px;
      max-inline-size: none !important;
    }
    :where(.lesson > :not(header), .lesson header > :not(.cover), .name > *) {
      max-inline-size: 44rem;
    }
    .print {
      max-block-size: min(62vh, 560px);
      inline-size: 100%;
    }
  }
</style>
