---
// PROTOTYPE (#55) variant A4, "Play on the photo": the photo works like album art. A round ipê play
// button sits on its bottom corner, and that is the page's only Play, so the photo and the audio
// read as one thing. The photo leads the header on the left; no photo (Supplementary) leaves an ipê
// tile in its place. On a phone the photo and the facts share a row, so the title and the intro
// start higher than in A2.
import Icon from '../../../components/Icon.astro';
import Base from '../../../layouts/Base.astro';
import Switcher from '../_Switcher.astro';
import Parts from '../_AParts.astro';
import { sampleStaticPaths, view } from '../_lesson';
import '../_a-family.css';

export const getStaticPaths = sampleStaticPaths;
const { lesson } = Astro.props;
const v = view(lesson);
---

<Base title={`${v.series} ${v.number}: ${v.title}`} noindex>
  <article class="af a4" data-proto-lesson={v.trackJson}>
    <header>
      <div class:list={['art', { blank: !v.photo }]}>
        {v.photo && <img src={v.photo.url} alt={v.photo.alt} />}
        <button type="button" class="play" data-proto-play>
          <Icon name="play" class="i-play" /><Icon name="pause" class="i-pause" />
          <span class="visually-hidden"><span data-proto-label>Play</span> lesson</span>
        </button>
      </div>
      <div class="meta">
        <p class="af-series">{v.series} {v.number}</p>
        <p class="af-facts">
          First published <time datetime={v.isoDate}>{v.date}</time>.<br />{v.minutes} of audio.
          <span class="af-left" data-proto-left></span>
        </p>
        {v.topic && <p class="topic">Culture talk: {v.topic}</p>}
      </div>
      <h1 class="af-title">{v.title}</h1>
    </header>
    <Parts part="body" v={v} />
  </article>
  <Switcher variant="a4" lesson={lesson.id} />
</Base>

<script>
  import '../_play';
</script>

<style>
  .a4 {
    max-inline-size: 46rem;
  }
  header {
    display: grid;
    grid-template-columns: clamp(120px, 34vw, 200px) 1fr;
    grid-template-areas: 'art meta' 'title title';
    column-gap: var(--space-16);
    align-items: end;
  }
  .art {
    grid-area: art;
    position: relative;
    margin-block-end: 22px;
  }
  .art img,
  .art.blank::before {
    display: block;
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-card);
  }
  .art.blank::before {
    content: '';
    background: var(--strong);
  }
  .play {
    position: absolute;
    inset-block-end: -22px;
    inset-inline-end: -10px;
    display: grid;
    place-items: center;
    inline-size: 64px;
    block-size: 64px;
    border: 4px solid var(--surface);
    border-radius: 50%;
    background: var(--ipe);
    color: var(--on-ipe);
  }
  .play :global(.icon) {
    inline-size: 26px;
    block-size: 26px;
  }
  .meta {
    grid-area: meta;
    display: grid;
    gap: var(--space-4);
    padding-block-end: var(--space-24);
  }
  .af-facts {
    font-size: var(--text-14);
  }
  .af-left {
    display: block;
    margin-block-start: var(--space-4);
    color: var(--ink);
    font-weight: 500;
  }
  .topic {
    color: var(--muted);
    font-size: var(--text-14);
  }
  .af-title {
    grid-area: title;
    margin-block: var(--space-16) 0;
  }

  @media (min-width: 64rem) {
    header {
      grid-template-areas: 'art meta' 'art title';
      grid-template-rows: auto 1fr;
      column-gap: 36px;
      align-items: start;
    }
    .meta {
      padding-block-end: 0;
    }
    .af-facts br {
      display: none;
    }
  }
</style>
