---
// PROTOTYPE (#62), throwaway, never merged. The chosen motion ("Sheets", src/pages/proto/_motion.css)
// with a floating bar to judge it: "Slow ×5" stretches every duration, "Reduced" simulates
// prefers-reduced-motion. The variants tried before it are in this branch's history.
import './_motion.css';
---

<div class="proto-bar" data-proto-bar transition:persist="proto-bar" aria-label="Prototype: motion">
  <span>Sheets</span>
  <label><input type="checkbox" data-slow /> Slow ×5</label>
  <label><input type="checkbox" data-rm /> Reduced</label>
</div>

<script>
  const store = {
    get: (k: string) => {
      try { return sessionStorage.getItem(`proto62-${k}`); } catch { return null; }
    },
    set: (k: string, v: string) => {
      try { sessionStorage.setItem(`proto62-${k}`, v); } catch {}
    },
  };
  let slow = store.get('slow') === '1';
  let rm = store.get('rm') === '1';
  function apply(root: HTMLElement) {
    root.style.setProperty('--slow', slow ? '5' : '1');
    root.toggleAttribute('data-rm', rm);
  }
  function bindBar() {
    apply(document.documentElement);
    const bar = document.querySelector<HTMLElement>('[data-proto-bar]');
    if (!bar || bar.dataset.bound) return;
    bar.dataset.bound = '1';
    const s = bar.querySelector<HTMLInputElement>('[data-slow]')!;
    const r = bar.querySelector<HTMLInputElement>('[data-rm]')!;
    s.checked = slow;
    r.checked = rm;
    s.addEventListener('change', () => { slow = s.checked; store.set('slow', slow ? '1' : '0'); apply(document.documentElement); });
    r.addEventListener('change', () => { rm = r.checked; store.set('rm', rm ? '1' : '0'); apply(document.documentElement); });
  }

  // Desktop: home is the bottom sheet, so going home is always Back (the lesson sheet is pulled
  // off), even from a link, which history counts as forward. On a phone, home is reached from the
  // Lessons view and moves forward like any page; it's the Lessons view that is underneath.
  const wide = matchMedia('(min-width: 52rem)');
  document.addEventListener('astro:before-preparation', (e) => {
    if (wide.matches && e.to.pathname === '/' && e.from.pathname !== '/') e.direction = 'back';
  });
  document.addEventListener('astro:before-swap', (e) => apply(e.newDocument.documentElement));

  // Focus: a click in the persisted sidebar keeps focus on that row (desktop). Anything else would
  // leave focus on <body>; move it to the page's <main> (tabindex=-1) without scrolling.
  let navigated = false;
  document.addEventListener('astro:page-load', () => {
    bindBar();
    if (navigated && (document.activeElement === document.body || !document.activeElement?.checkVisibility())) {
      document.querySelector<HTMLElement>('#main')?.focus({ preventScroll: true });
    }
    navigated = true;
  });

  // The phone's Lessons view is a same-page #lessons switch, which the ClientRouter doesn't
  // animate. src/lib/sidebar-ui.ts calls this: to Lessons is "back", to a page is "forward".
  (window as any).__protoViewSwap = (update: () => void, dir: 'forward' | 'back') => {
    if (!document.startViewTransition) return update();
    const root = document.documentElement;
    const token = String(Math.random());
    root.setAttribute('data-astro-transition', dir);
    root.dataset.swap = token;
    document.startViewTransition(update).finished.finally(() => {
      // Only if no later swap has taken over the attribute.
      if (root.dataset.swap === token) root.removeAttribute('data-astro-transition');
    });
  };
</script>

<style is:global>
  .proto-bar {
    view-transition-name: proto-bar;
    position: fixed;
    inset-block-start: calc(env(safe-area-inset-top, 0px) + 8px);
    inset-inline-end: 8px;
    z-index: 50;
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 6px 10px;
    border-radius: 10px;
    background: #ff2bd6;
    color: #000;
    font: 600 13px/1.2 system-ui, sans-serif;
  }
  .proto-bar label { display: inline-flex; gap: 4px; align-items: center; }
  ::view-transition-group(proto-bar) { animation: none; z-index: 100; }
  ::view-transition-old(proto-bar) { display: none; }
  ::view-transition-new(proto-bar) { animation: none; }
</style>
