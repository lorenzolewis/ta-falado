---
// PROTOTYPE (#55) variant C, "Number and rail": the lesson number is the hero, set huge in the
// serif, with the series name beside it and the title below. On desktop a narrow rail on the right
// holds what you do (Play, Transcript) and what it is (date, length, photo and culture topic);
// on a phone the actions become one row under the title and the photo moves after the intro.
// PT words bold; ES words plain italic.
import Icon from '../../../components/Icon.astro';
import Base from '../../../layouts/Base.astro';
import Switcher from '../_Switcher.astro';
import { sampleStaticPaths, view } from '../_lesson';

export const getStaticPaths = sampleStaticPaths;
const { lesson } = Astro.props;
const v = view(lesson);
---

<Base title={`${v.series} ${v.number}: ${v.title}`} noindex>
  <article class="c" data-proto-lesson={v.trackJson}>
    <header>
      <p class="mark"><span class="num">{v.number}</span><span class="series">{v.series}</span></p>
      <h1><span class="visually-hidden">{v.series} {v.number}: </span>{v.title}</h1>
    </header>

    <div class="actions">
      <button type="button" class="btn btn-accent" data-proto-play>
        <Icon name="play" class="i-play" /><Icon name="pause" class="i-pause" /><span data-proto-label>Play</span>
      </button>
      <a class="btn ghost" href={v.pdf}><Icon name="doc" />Transcript</a>
      <span class="meter" aria-hidden="true"><span></span></span>
      <p class="left" data-proto-left></p>
    </div>

    <dl class="facts">
      <div><dt>First published</dt><dd><time datetime={v.isoDate}>{v.date}</time></dd></div>
      <div><dt>Length</dt><dd>{v.duration}</dd></div>
      {v.pdfSize && <div><dt>Transcript</dt><dd>PDF, {v.pdfSize}</dd></div>}
    </dl>

    <div class="intro" set:html={v.intro} />

    {
      v.photo && (
        <figure>
          <img src={v.photo.url} alt={v.photo.alt} />
          {v.topic && (
            <figcaption>
              Culture talk: <strong>{v.topic}</strong>
            </figcaption>
          )}
        </figure>
      )
    }
  </article>
  <Switcher variant="c" lesson={lesson.id} />
</Base>

<script>
  import '../_play';
</script>

<style>
  p {
    margin: 0;
  }
  .c {
    display: grid;
    grid-template-areas: 'header' 'actions' 'intro' 'figure' 'facts';
    gap: var(--space-24);
    max-inline-size: 60rem !important;
  }
  header {
    grid-area: header;
  }
  .mark {
    display: flex;
    align-items: flex-end;
    gap: var(--space-12);
  }
  .num {
    color: var(--accent);
    font: 700 clamp(6rem, 22vw, 10rem) / 0.78 var(--font-serif);
    letter-spacing: -0.04em;
    font-variant-numeric: lining-nums;
  }
  .series {
    padding-block-end: var(--space-4);
    color: var(--muted);
    font: 700 var(--text-21) / 1 var(--font-sans);
  }
  h1 {
    margin: var(--space-16) 0 0;
    font-size: var(--text-36);
    text-wrap: balance;
  }

  .actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
  }
  .ghost {
    background: var(--selected);
    color: var(--accent);
  }
  .meter {
    display: none;
    flex-basis: 100%;
    block-size: 4px;
    margin-block-start: var(--space-8);
    border-radius: var(--radius-pill);
    background: var(--line);
  }
  [data-state='started'] .meter,
  [data-state='paused'] .meter,
  [data-state='playing'] .meter,
  [data-state='loading'] .meter {
    display: block;
  }
  .meter > span {
    display: block;
    block-size: 100%;
    inline-size: calc(var(--done, 0) * 1%);
    border-radius: inherit;
    background: var(--accent);
  }
  .left {
    flex-basis: 100%;
    color: var(--muted);
    font-size: var(--text-14);
  }
  [data-proto-play] :global(.i-pause),
  [data-state='playing'] :global(.i-play),
  [data-state='loading'] :global(.i-play) {
    display: none;
  }
  [data-state='playing'] :global(.i-pause),
  [data-state='loading'] :global(.i-pause) {
    display: block;
  }

  .facts {
    grid-area: facts;
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding-block-start: var(--space-16);
    border-block-start: 1px solid var(--line);
    font-size: var(--text-14);
  }
  .facts div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-12);
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .intro {
    grid-area: intro;
    max-inline-size: 36rem;
    font: var(--text-18) / 1.6 var(--font-serif);
  }
  .intro :global(.w-pt) {
    font-style: normal;
    font-weight: 700;
  }
  figure {
    grid-area: figure;
    margin: 0;
  }
  figure img {
    display: block;
    inline-size: 100%;
    max-inline-size: 240px;
    border-radius: var(--radius-row);
  }
  figcaption {
    margin-block-start: var(--space-8);
    color: var(--muted);
    font-size: var(--text-14);
  }
  figcaption strong {
    color: var(--ink);
  }

  @media (min-width: 64rem) {
    .c {
      grid-template-columns: 1fr 15rem;
      grid-template-areas:
        'header header'
        'intro actions'
        'intro facts'
        'intro figure';
      grid-template-rows: auto auto auto 1fr;
      column-gap: 48px;
      align-items: start;
    }
    .actions {
      flex-direction: column;
      align-items: stretch;
    }
    .actions .btn {
      justify-content: center;
    }
    .intro {
      font-size: var(--text-21);
    }
    figure img {
      max-inline-size: 100%;
    }
  }
</style>
