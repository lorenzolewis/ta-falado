---
// PROTOTYPE (#53), variant C "Rail and map": every lesson as a numbered tile, so a series reads as
// a map of the course you work through. On desktop a sticky rail holds the name, Continue, the
// filter, a series index and the footer. The filter dims non-matching tiles instead of hiding them,
// so the map never reflows. On a phone, Continue comes first.
import FinishedMark from '../../components/FinishedMark.astro';
import { ICON } from '../../components/proto/icons';
import { homeData } from '../../components/proto/home-data';
import ProtoHead from '../../components/proto/ProtoHead.astro';
import ProtoSwitcher from '../../components/proto/ProtoSwitcher.astro';
import Base from '../../layouts/Base.astro';

const groups = await homeData();
---

<Base title="Home C (prototype)" noindex bare>
  <ProtoHead slot="head" />
  <div class="vc" data-variant="c">
    <aside class="rail">
      <div class="rail-in">
        <section class="continue" aria-labelledby="c-continue" data-continue hidden>
          <h2 id="c-continue">Pick up where you stopped</h2>
          <p class="continue-title"><a data-continue-link href="/"></a></p>
          <div class="meter" data-continue-bar><span></span></div>
          <p class="continue-row">
            <button type="button" class="btn" data-continue-play><Fragment set:html={ICON.play} />Resume</button>
            <span class="continue-time" data-continue-left></span>
          </p>
          <p class="visually-hidden" data-continue-time></p>
        </section>

        <header class="brand">
          <h1><a href="/proto/home-c" lang="pt-BR">Tá Falado</a></h1>
          <p class="lede">Brazilian Portuguese pronunciation and grammar lessons for Spanish speakers.</p>
        </header>

        <search class="filter">
          <label for="lesson-filter">Find a lesson</label>
          <div class="field">
            <Fragment set:html={ICON.search} />
            <input type="search" id="lesson-filter" autocomplete="off" placeholder="nh, ão, ficar…" />
            <button type="button" class="clear" data-clear hidden aria-label="Clear the filter"
              ><Fragment set:html={ICON.close} /></button
            >
          </div>
          <p class="status" id="lesson-filter-status" role="status"></p>
        </search>

        <nav class="index" aria-label="Series">
          <ul>
            {
              groups.map((g) => (
                <li>
                  <a href={`#c-${g.id}`}>
                    <span class="index-name">{g.label}</span>
                    <span class="index-count" data-index-count={g.id}>
                      {g.size}
                    </span>
                  </a>
                  <span class="index-meter" data-finished-bar={g.id} data-size={g.size}>
                    <span />
                  </span>
                </li>
              ))
            }
          </ul>
        </nav>

        <footer class="foot foot-rail">
          <p>An independent, unofficial archive.</p>
          <p>
            Lessons by COERLL, University of Texas at Austin, under <a
              href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a
            >.
          </p>
          <p><a href="/about">About this site</a></p>
        </footer>
      </div>
    </aside>

    <main id="main" class="map">
      {
        groups.map((g) => (
          <section class="series" id={`c-${g.id}`} aria-labelledby={`c-h-${g.id}`}>
            <div class="series-head">
              <h2 id={`c-h-${g.id}`}>{g.label}</h2>
              <p class="series-meta">
                {g.size} lessons
                <span data-has-finished hidden>
                  , <span data-finished-count={g.id}>0</span> finished
                </span>
              </p>
            </div>
            <ol class="tiles">
              {g.rows.map((r) => (
                <li class="tile" data-filter-text={r.filterText} data-path={r.path} data-seconds={r.seconds} data-series-id={g.id}>
                  <span class="tile-top">
                    <span class="num" aria-hidden="true">
                      {r.number}
                    </span>
                    <span class="mark">
                      <FinishedMark id={r.path} />
                    </span>
                  </span>
                  <a href={r.path}>
                    <span class="visually-hidden">{g.label} {r.number}: </span>
                    {g.id === 'pronunciation' ? r.short : r.title}
                  </a>
                  {r.topic && <span class="topic">{r.topic}</span>}
                  <time datetime={r.iso}>{r.duration}</time>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
      <footer class="foot foot-end">
        <p>
          <b>An independent, unofficial archive.</b> Lessons by COERLL, University of Texas at Austin, under <a
            href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a
          >. <a href="/about">About this site</a>
        </p>
      </footer>
    </main>
  </div>
  <ProtoSwitcher current="c" />
</Base>

<style is:global>
  .vc p {
    margin-block: 0;
  }
  .vc {
    max-inline-size: 76rem;
    margin-inline: auto;
    padding-inline: 16px;
  }
  @media (min-width: 60rem) {
    .vc {
      display: grid;
      grid-template-columns: 20rem 1fr;
      gap: 48px;
      padding-inline: 32px;
    }
    .vc .rail-in {
      position: sticky;
      inset-block-start: 0;
      max-block-size: 100dvh;
      overflow-y: auto;
      padding-block: 32px;
    }
    .vc .map .foot-end {
      display: none;
    }
    /* On desktop the name leads; Continue sits under it. */
    .vc .brand {
      order: -1;
    }
  }
  @media (max-width: 59.99rem) {
    .vc .rail .foot-rail,
    .vc .rail .index {
      display: none;
    }
    .vc .rail-in {
      padding-block: 16px 0;
    }
  }
  .vc .rail-in {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .vc .brand h1 {
    font: 700 3.75rem/1 var(--serif);
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }
  .vc .brand h1 a {
    color: var(--ink);
    text-decoration: none;
  }
  .vc .lede {
    font: 1.3125rem/1.45 var(--serif);
    color: var(--muted);
  }
  .vc .continue {
    display: grid;
    gap: 8px;
    padding: 20px;
    border-radius: 20px;
    background: var(--strong);
    color: var(--on-strong);
  }
  .vc .continue[hidden] {
    display: none;
  }
  .vc .continue h2 {
    font-size: 0.875rem;
    font-weight: 500;
    margin: 0;
  }
  .vc .continue-title {
    font: 700 1.5rem/1.1 var(--serif);
  }
  .vc .continue-title a {
    color: inherit;
    text-decoration: none;
  }
  .vc .continue :focus-visible {
    outline-color: var(--ipe);
  }
  .vc .meter {
    block-size: 8px;
    border-radius: 999px;
    background: var(--track-on-strong);
    margin-block: 4px;
  }
  .vc .meter > span {
    display: block;
    block-size: 100%;
    inline-size: var(--p, 0%);
    border-radius: inherit;
    background: var(--ipe);
  }
  .vc .continue-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-block-start: 4px;
  }
  .vc .continue-time {
    font-size: 0.875rem;
  }
  .vc .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-block-size: 48px;
    padding: 0 22px 0 16px;
    border: 0;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1.125rem;
    background: var(--ipe);
    color: var(--on-ipe);
    cursor: pointer;
  }
  .vc .btn .icon {
    inline-size: 20px;
    block-size: 20px;
  }
  .vc .filter {
    display: grid;
    gap: 6px;
  }
  .vc .filter label {
    font-weight: 500;
    font-size: 0.875rem;
  }
  .vc .field {
    display: flex;
    align-items: center;
    gap: 8px;
    min-block-size: 48px;
    padding-inline: 16px 6px;
    border: 2px solid var(--control);
    border-radius: 999px;
    background: var(--surface);
  }
  .vc .field:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .vc .field > .icon {
    color: var(--muted);
    inline-size: 20px;
    block-size: 20px;
  }
  .vc .field input {
    flex: 1;
    min-inline-size: 0;
    border: 0;
    background: transparent;
    outline: none;
    font-size: 1.125rem;
  }
  .vc .field input::-webkit-search-cancel-button {
    display: none;
  }
  .vc .field input::placeholder {
    color: var(--muted);
  }
  .vc .clear {
    display: grid;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    border: 0;
    border-radius: 999px;
    background: var(--line);
    cursor: pointer;
  }
  .vc .clear[hidden] {
    display: none;
  }
  .vc .clear .icon {
    inline-size: 16px;
    block-size: 16px;
  }
  .vc .status {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .vc .status:empty {
    display: none;
  }
  .vc .index ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .vc .index li {
    display: grid;
    gap: 2px;
  }
  .vc .index a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: 6px 2px;
    font: 700 1.3125rem/1.2 var(--serif);
    color: var(--ink);
    text-decoration: none;
  }
  .vc .index a:hover .index-name {
    text-decoration: underline;
  }
  .vc .index-count {
    font: 400 0.875rem var(--sans);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .vc .index-meter {
    block-size: 4px;
    border-radius: 999px;
    background: var(--line);
  }
  .vc .index-meter > span {
    display: block;
    block-size: 100%;
    inline-size: var(--p, 0%);
    border-radius: inherit;
    background: var(--accent);
  }
  .vc .foot {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.45;
    display: grid;
    gap: 4px;
  }
  .vc .foot b,
  .vc .foot-rail p:first-child {
    color: var(--ink);
    font-weight: 500;
  }
  .vc .foot-end {
    margin-block: 40px 0;
    padding-block: 16px 32px;
    border-block-start: 1px solid var(--line);
  }
  .vc .map {
    padding-block: 8px 0;
  }
  @media (min-width: 60rem) {
    .vc .map {
      padding-block: 32px;
    }
  }
  .vc .series {
    scroll-margin-block-start: 16px;
  }
  .vc .series-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
    margin-block: 32px 12px;
  }
  .vc .series:first-child .series-head {
    margin-block-start: 24px;
  }
  @media (min-width: 60rem) {
    .vc .series:first-child .series-head {
      margin-block-start: 0;
    }
  }
  .vc .series h2 {
    font: 700 2.25rem/1 var(--serif);
    margin: 0;
  }
  .vc .series-meta {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .vc [data-has-finished][hidden] {
    display: none;
  }
  .vc .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 8px;
  }
  .vc .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 14px 12px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    min-block-size: 8.5rem;
  }
  .vc .tile-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .vc .num {
    font: 700 2.25rem/1 var(--serif);
    color: var(--accent);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .vc .tile a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 1.0625rem;
    line-height: 1.2;
    margin-block-start: auto;
  }
  .vc .tile a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .vc .tile a:hover {
    text-decoration: underline;
  }
  .vc .tile a:focus-visible {
    outline: none;
  }
  .vc .tile:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .vc .topic {
    font: italic 0.875rem/1.3 var(--serif);
    color: var(--muted);
  }
  .vc .tile time {
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .vc .mark [data-finished]:not([hidden]) {
    display: grid;
    place-items: center;
    inline-size: 24px;
    block-size: 24px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    font-size: 0.875rem;
  }
  /* Finished tiles go quiet; the one in progress gets an ipê edge. */
  .vc .tile[data-state='finished'] {
    background: transparent;
  }
  .vc .tile[data-state='started'] {
    border: 2px solid var(--ipe);
    box-shadow: inset 0 -6px 0 var(--ipe);
  }
  /* Filtering: tiles that don't match fade back and drop out of the tab order. */
  .vc .tile.dim {
    opacity: 0.22;
  }
  .vc .tile.hit {
    border-color: var(--accent);
  }
</style>

<script>
  import { onPage, showProgress, wireFilter } from '../../components/proto/proto-client';

  onPage((signal) => {
    if (!document.querySelector('[data-variant="c"]')) return;
    showProgress();
    const input = document.querySelector<HTMLInputElement>('#lesson-filter')!;
    const status = document.querySelector<HTMLElement>('#lesson-filter-status')!;
    const clear = document.querySelector<HTMLButtonElement>('[data-clear]')!;
    const counts = [...document.querySelectorAll<HTMLElement>('[data-index-count]')];
    const run = wireFilter(
      input,
      ({ query, matches, rows }) => {
        rows.forEach((row, i) => {
          const off = !!query && !matches.has(i);
          row.classList.toggle('dim', off);
          row.classList.toggle('hit', !!query && !off);
          row.inert = off;
        });
        for (const c of counts) {
          const all = rows.filter((r) => r.dataset.seriesId === c.dataset.indexCount);
          const n = all.filter((r) => !r.classList.contains('dim')).length;
          c.textContent = query ? `${n} of ${all.length}` : String(all.length);
        }
        clear.hidden = !query;
        status.textContent = !query
          ? ''
          : matches.size
            ? `${matches.size} ${matches.size === 1 ? 'lesson matches' : 'lessons match'}, highlighted below.`
            : 'No lessons match. Try fewer words, a sound like nh, or a topic like food.';
      },
      signal,
    );
    clear.addEventListener('click', () => ((input.value = ''), run(), input.focus()), { signal });
  });
</script>
