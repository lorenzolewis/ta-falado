---
// PROTOTYPE (#57), variant C, "Cast list": people first, like a theatre programme. An index of names
// at the top, then each person in large type with their role and where they're from, and their bio
// read in full. The licence, notice and links close the page as a colophon panel in --strong.
// Throwaway: never merged.
import Base from '../../layouts/Base.astro';
import Switcher from './_Switcher.astro';
import { LINKS, TEAM } from './_about';

const people = TEAM.flatMap(({ people }) => people);
---

<Base title="About" noindex>
  <article class="lc">
    <h1>About this site</h1>
    <p class="lede">
      <i lang="pt-BR">Tá Falado</i> was made in 2006 and 2007 at the University of Texas at Austin by a host, three
      regular voices, two guests and a production team. This independent, unofficial archive keeps their 46 lessons
      playing.
    </p>

    <nav class="index" aria-label="The team">
      <ul>
        {people.map((p) => (
          <li><a href={`#${p.id}`} set:html={p.nameHtml ?? p.name} /></li>
        ))}
      </ul>
    </nav>

    <ol class="cast">
      {
        people.map((p) => (
          <li class="member" id={p.id}>
            <h2 set:html={p.nameHtml ?? p.name} />
            <p class="part">
              {p.role}
              {(p.from || p.note) && <span class="from">{[p.from && `from ${p.from}`, p.note].filter(Boolean).join(', ')}</span>}
            </p>
            <div class="bio" set:html={p.bio} />
          </li>
        ))
      }
    </ol>
    <p class="support">
      Funding and production support from the <a href={LINKS.tltc}>Texas Language Technology Center</a> and{' '}
      <a href={LINKS.laits}>Liberal Arts Instructional Technology Services</a>, College of Liberal Arts, University of Texas
      at Austin. Bios from the <a href={LINKS.originalAbout}>original About page</a>.
    </p>

    <section class="colophon" aria-labelledby="lc-colophon">
      <h2 id="lc-colophon">License and credits</h2>
      <p>
        <strong>Not affiliated with or endorsed by the University of Texas at Austin or COERLL.</strong>
      </p>
      <p>
        <cite><span lang="pt-BR">Tá Falado</span>: Brazilian Portuguese Pronunciation for Speakers of Spanish</cite>, by
        the podcasting team from the University of Texas at Austin. Published by COERLL at{' '}
        <a href={LINKS.original}>coerll.utexas.edu/brazilpod/tafalado</a> (archived March 2, 2026). © 2025, University of
        Texas at Austin. <a href={LINKS.ccby}>CC BY 3.0</a>.
      </p>
      <p>
        Modified: re-hosted and re-presented. The MP3s, PDF transcripts and photos are served unchanged; this site gives
        them new pages, a new player and a new podcast feed. The lesson photos are shared under the same license;{' '}
        <a href={LINKS.issues}>open an issue</a> to have one removed.
      </p>
      <p>This site's code is MIT-licensed. Its artwork is set in Alegreya and Alegreya Sans (SIL Open Font License).</p>
      <div class="actions">
        <a class="btn btn-ipe" href={LINKS.repo}>Source code</a>
        <a class="plain" href={LINKS.license}>MIT license</a>
        <a class="plain" href={LINKS.credits}>CREDITS.md</a>
      </div>
    </section>
  </article>
  <Switcher variant="c" />
</Base>

<style>
  .lc {
    max-inline-size: 42rem;
  }
  .lede {
    font: var(--text-21) / 1.5 var(--font-serif);
  }

  .index ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin: var(--space-24) 0 0;
    padding: 0;
    list-style: none;
  }
  .index a {
    display: inline-flex;
    align-items: center;
    min-block-size: 40px;
    padding: 0 var(--space-12);
    border-radius: var(--radius-pill);
    background: var(--selected);
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }

  .cast {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .member {
    padding-block: 40px var(--space-8);
    border-block-end: 1px solid var(--line);
    scroll-margin-block-start: var(--space-16);
  }
  .member h2 {
    margin: 0;
    font-size: clamp(var(--text-36), 7vw, 3.25rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .part {
    margin: var(--space-8) 0 var(--space-16);
    color: var(--accent);
    font-weight: 700;
  }
  .from {
    display: block;
    color: var(--muted);
    font-weight: 400;
  }
  .bio {
    font: var(--text-18) / 1.6 var(--font-serif);
  }
  .bio :global(p) {
    margin-block: 0 var(--space-16);
  }
  .support {
    margin-block: var(--space-24) 48px;
    color: var(--muted);
  }

  .colophon {
    padding: var(--space-24) 20px;
    border-radius: var(--radius-card);
    background: var(--strong);
    color: var(--on-strong);
    font: var(--text-18) / 1.5 var(--font-serif);
  }
  .colophon h2 {
    margin: 0 0 var(--space-12);
    font-size: var(--text-28);
  }
  .colophon strong {
    font-family: var(--font-sans);
  }
  .colophon a {
    color: inherit;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8) var(--space-24);
    margin-block-start: var(--space-24);
    font-family: var(--font-sans);
  }
  .colophon .btn-ipe {
    color: var(--on-ipe);
  }
  .plain {
    font-weight: 700;
  }
</style>
