---
// PROTOTYPE (#57): the floating bar that flips between About variants (‹ ›, or [ and ]).
// It sits above the mini-player and the tab bar. ← and → are left to the player's own shortcuts.
import { VARIANTS } from './_about';

interface Props {
  variant: (typeof VARIANTS)[number]['key'];
}
const { variant } = Astro.props;
const i = VARIANTS.findIndex((v) => v.key === variant);
const at = (n: number) => VARIANTS[(n + VARIANTS.length) % VARIANTS.length]!;
const href = (key: string) => `/proto/about-${key}`;
---

<div class="proto-bar" data-proto-bar>
  <a href={href(at(i - 1).key)} aria-label={`Previous variant: ${at(i - 1).name}`} data-proto-prev>‹</a>
  <span class="label"><b>{variant.toUpperCase()}</b> {VARIANTS[i]!.name}</span>
  <a href={href(at(i + 1).key)} aria-label={`Next variant: ${at(i + 1).name}`} data-proto-next>›</a>
</div>

<script>
  import { navigate } from 'astro:transitions/client';

  let page: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    page?.abort();
    const bar = document.querySelector<HTMLElement>('[data-proto-bar]');
    if (!bar) return;
    page = new AbortController();
    document.addEventListener(
      'keydown',
      (e) => {
        if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
        const link = e.key === '[' ? '[data-proto-prev]' : e.key === ']' ? '[data-proto-next]' : null;
        if (link) navigate(bar.querySelector<HTMLAnchorElement>(link)!.href);
      },
      { signal: page.signal },
    );
  });
</script>

<style>
  .proto-bar {
    position: fixed;
    inset-block-end: calc(var(--player-block-size, 0px) + var(--tabs-block-size) + 12px);
    inset-inline-start: 50%;
    translate: -50% 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    border-radius: 999px;
    background: #ff2bd6;
    color: #000;
    font: 600 14px/1 system-ui, sans-serif;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.35);
    white-space: nowrap;
  }
  a {
    display: grid;
    place-items: center;
    inline-size: 32px;
    block-size: 32px;
    border-radius: 999px;
    background: #000;
    color: #fff;
    font-size: 20px;
    text-decoration: none;
  }
  .label {
    padding-inline: 4px;
  }
</style>
