---
// PROTOTYPE (#55): the floating bar that flips between variants (‹ ›, or [ and ]) and sample lessons.
// It sits above the mini-player and the tab bar. ← and → are left to the player's own shortcuts.
import { SAMPLES, VARIANTS } from './_lesson';

interface Props {
  variant: (typeof VARIANTS)[number]['key'];
  lesson: string;
}
const { variant, lesson } = Astro.props;
const i = VARIANTS.findIndex((v) => v.key === variant);
const at = (n: number) => VARIANTS[(n + VARIANTS.length) % VARIANTS.length]!;
const href = (key: string, slug = lesson) => `/proto/lesson-${key}/${slug}`;
---

<div class="proto-bar" data-proto-bar>
  <a href={href(at(i - 1).key)} aria-label={`Previous variant: ${at(i - 1).name}`} data-proto-prev>‹</a>
  <span class="label"><b>{variant.toUpperCase()}</b> {VARIANTS[i]!.name}</span>
  <a href={href(at(i + 1).key)} aria-label={`Next variant: ${at(i + 1).name}`} data-proto-next>›</a>
  <select aria-label="Sample lesson" data-proto-lesson>
    {SAMPLES.map((slug) => <option value={href(variant, slug)} selected={slug === lesson}>{slug}</option>)}
  </select>
</div>

<script>
  import { navigate } from 'astro:transitions/client';

  let page: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    page?.abort();
    const bar = document.querySelector<HTMLElement>('[data-proto-bar]');
    if (!bar) return;
    page = new AbortController();
    const { signal } = page;
    bar.querySelector('select')!.addEventListener('change', (e) => navigate((e.target as HTMLSelectElement).value), { signal });
    document.addEventListener(
      'keydown',
      (e) => {
        if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
        const link = e.key === '[' ? '[data-proto-prev]' : e.key === ']' ? '[data-proto-next]' : null;
        if (link) navigate(bar.querySelector<HTMLAnchorElement>(link)!.href);
      },
      { signal },
    );
  });
</script>

<style>
  .proto-bar {
    position: fixed;
    inset-block-end: calc(var(--player-block-size, 0px) + var(--tabs-block-size) + 12px);
    inset-inline-start: 50%;
    translate: -50% 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    border-radius: 999px;
    background: #ff2bd6;
    color: #000;
    font: 600 14px/1 system-ui, sans-serif;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.35);
    white-space: nowrap;
  }
  a {
    display: grid;
    place-items: center;
    inline-size: 32px;
    block-size: 32px;
    border-radius: 999px;
    background: #000;
    color: #fff;
    font-size: 20px;
    text-decoration: none;
  }
  .label {
    max-inline-size: 9rem;
    overflow: hidden;
    text-overflow: ellipsis;
    padding-inline: 4px;
  }
  select {
    max-inline-size: 9rem;
    border: 0;
    border-radius: 999px;
    padding: 6px 8px;
    background: #fff;
    color: #000;
    font: inherit;
  }
</style>
