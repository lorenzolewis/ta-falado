---
import FinishedMark from '../components/FinishedMark.astro';
import Base from '../layouts/Base.astro';
import { formatDuration, isoDuration } from '../lib/format';
import { SERIES, lessonPath, lessonsBySeries } from '../lib/lessons';
import { SERIES_LABEL } from '../lib/series';

const series = await Promise.all(SERIES.map(async (id) => ({ id, lessons: await lessonsBySeries(id) })));
---

<Base>
  <h1 lang="pt-BR">Tá Falado</h1>
  <p>Brazilian Portuguese pronunciation and grammar lessons for Spanish speakers.</p>
  <section aria-labelledby="continue" data-continue hidden>
    <h2 id="continue">Continue where you left off</h2>
    <p><a data-continue-link href="/"></a>, <span data-continue-time></span></p>
    <p><button type="button" data-continue-play>Resume</button></p>
  </section>
  {
    series.map(({ id, lessons }) => (
      <section aria-labelledby={`series-${id}`}>
        <h2 id={`series-${id}`}>{SERIES_LABEL[id]}</h2>
        <ol>
          {lessons.map(({ data }) => (
            <li value={data.number}>
              <a href={lessonPath(data)}>{data.title}</a>
              {data.topic && <>, {data.topic}</>}
              {' · '}
              <time datetime={isoDuration(data.audio.durationSeconds)}>
                {formatDuration(data.audio.durationSeconds)}
              </time>{' '}
              <FinishedMark id={lessonPath(data)} />
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Base>
