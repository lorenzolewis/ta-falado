---
// PROTOTYPE (#53): the #52 fonts from Google Fonts. The build (#54) commits the TTFs instead.
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,400;0,700;1,400;1,700&family=Alegreya+Sans:wght@400;500;700&display=swap"
/>
<script is:inline>
  // Prototype theme override (auto, light, dark), applied before paint.
  try {
    const t = localStorage.getItem('proto:theme');
    if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
  } catch {}
</script>
