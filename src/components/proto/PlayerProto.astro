---
// PROTOTYPE (#59), never merged: the chosen mini-player, variant A ("bar and sheet"), in place of
// src/components/Player.astro. A slim bar with back 10s and play, and progress as a line along
// its top edge; on a phone, the bar opens a sheet with everything; on desktop it is one full row.
// The other variants (B full deck, C floating card) are at commit 6b53939.
import Icon from '../Icon.astro';
import { getLessons, toTrack } from '../../lib/lessons';
import { RATES } from '../../lib/player';

const tracks = JSON.stringify((await getLessons()).map(toTrack)).replaceAll('<', '\\u003c');
---

<div class="pp" data-player-wrap data-state="idle" transition:persist="player">
  <section class="v va" aria-label="Audio player" data-player hidden>
    <div class="a-line" aria-hidden="true"></div>
    <div class="a-row">
      <button type="button" class="a-open" data-proto="open-sheet" aria-haspopup="dialog">
        <span class="a-art" data-proto-art aria-hidden="true"></span>
        <span class="a-text">
          <span class="a-title" data-proto-title></span>
          <span class="meta" data-proto-left></span>
          <span class="status" data-status role="status"></span>
        </span>
        <span class="visually-hidden">, open the player</span>
      </button>
      <div class="a-id">
        <span class="a-art" data-proto-art aria-hidden="true"></span>
        <span class="a-text">
          <a class="a-title" data-title href="/"></a>
          <span class="meta" data-proto-series></span>
        </span>
      </div>
      <div class="a-transport">
        <button type="button" class="ctl" data-action="back" aria-label="Back 10 seconds" aria-keyshortcuts="ArrowLeft"><Icon name="back10" /></button>
        <button type="button" class="play" data-action="toggle" aria-label="Play" aria-keyshortcuts="Space">
          <Icon name="play" class="i-play" /><Icon name="pause" class="i-pause" /><span class="i-spin"></span>
        </button>
        <button type="button" class="ctl a-desk" data-action="forward" aria-label="Forward 30 seconds" aria-keyshortcuts="ArrowRight"><Icon name="forward30" /></button>
      </div>
      <div class="seek a-desk">
        <span data-current>0:00</span>
        <input type="range" aria-label="Seek" min="0" max="0" step="1" value="0" data-seek />
        <span data-duration>0:00</span>
      </div>
      <div class="extra a-desk">
        <span class="speed">
          <select data-rate aria-label="Speed" aria-keyshortcuts="< >">
            {RATES.map((rate) => <option value={rate} selected={rate === 1}>{rate}×</option>)}
          </select>
          <Icon name="chevron" />
        </span>
        <button type="button" class="ctl" data-action="mute" aria-label="Mute" aria-pressed="false" aria-keyshortcuts="M">
          <Icon name="volume" class="i-vol" /><Icon name="mute" class="i-mute" />
        </button>
      </div>
    </div>

    <dialog class="a-sheet" data-proto-sheet aria-label="Player">
      <button type="button" class="ctl a-close" data-proto="close-sheet" aria-label="Close the player"><Icon name="chevron" /></button>
      <span class="a-big" data-proto-art aria-hidden="true"></span>
      <p class="a-sheet-title"><a data-title href="/"></a></p>
      <p class="meta" data-proto-series></p>
      <div class="a-sheet-seek">
        <input type="range" aria-label="Seek" min="0" max="0" step="1" value="0" data-seek />
        <span data-current>0:00</span>
        <span data-duration>0:00</span>
      </div>
      <div class="a-sheet-transport">
        <button type="button" class="ctl" data-action="back" aria-label="Back 10 seconds"><Icon name="back10" /></button>
        <button type="button" class="play big" data-action="toggle" aria-label="Play">
          <Icon name="play" class="i-play" /><Icon name="pause" class="i-pause" /><span class="i-spin"></span>
        </button>
        <button type="button" class="ctl" data-action="forward" aria-label="Forward 30 seconds"><Icon name="forward30" /></button>
      </div>
      <div class="a-sheet-extra">
        <span class="speed">
          <select data-rate aria-label="Speed">
            {RATES.map((rate) => <option value={rate} selected={rate === 1}>{rate}×</option>)}
          </select>
          <Icon name="chevron" />
        </span>
        <button type="button" class="ctl" data-action="mute" aria-label="Mute" aria-pressed="false">
          <Icon name="volume" class="i-vol" /><Icon name="mute" class="i-mute" />
        </button>
      </div>
    </dialog>
  </section>

  <script type="application/json" data-tracks is:inline set:html={tracks} />
</div>

<script>
  import '../../lib/player-ui';
  import '../../lib/progress-ui';
  import '../../lib/proto/player-proto';
</script>

<style>
  /* ───── Shared ───── */
  .pp {
    --on-strong-muted: color-mix(in srgb, var(--on-strong) 78%, var(--strong));
    position: sticky;
    /* Just above the phone's tab bar, which already includes the home-indicator inset. */
    inset-block-end: var(--tabs-block-size, 0px);
    z-index: 4;
  }
  .v[hidden] {
    display: none;
  }
  .v {
    color: var(--on-strong);
  }
  .v :focus-visible {
    outline-color: var(--ipe);
  }
  .v p {
    margin: 0;
  }
  .v a {
    color: inherit;
    text-decoration: none;
  }
  .v a:hover {
    text-decoration: underline;
  }
  .meta {
    color: var(--on-strong-muted);
    font-size: var(--text-14);
    font-variant-numeric: tabular-nums;
  }
  .status {
    color: var(--ipe);
    font-size: var(--text-14);
    font-weight: 500;
  }
  .status:empty,
  .pp[data-state='error'] .v .meta {
    display: none;
  }
  .ctl,
  .play {
    display: inline-grid;
    place-items: center;
    flex: none;
    inline-size: 48px;
    block-size: 48px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: inherit;
  }
  .ctl:hover {
    background: var(--track-on-strong);
  }
  .play {
    inline-size: 60px;
    block-size: 60px;
    background: var(--ipe);
    color: var(--on-ipe);
  }
  .play:disabled {
    cursor: default;
    opacity: 0.45;
  }
  .play :global(.icon) {
    inline-size: 26px;
    block-size: 26px;
  }
  /* Play, pause or the loading ring, from the player's state. */
  :global(.i-pause),
  .i-spin,
  .pp[data-state='playing'] :global(.i-play),
  .pp[data-state='loading'] :global(.i-play) {
    display: none;
  }
  .pp[data-state='playing'] :global(.i-pause) {
    display: block;
  }
  .pp[data-state='loading'] .i-spin {
    display: block;
    inline-size: 24px;
    block-size: 24px;
    border: 3px solid currentColor;
    border-inline-end-color: transparent;
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pp[data-state='loading'] .i-spin {
      animation: none;
      border-style: dotted;
    }
  }
  :global(.i-mute),
  [aria-pressed='true'] :global(.i-vol) {
    display: none;
  }
  [aria-pressed='true'] :global(.i-mute) {
    display: block;
  }

  /* Seek: an 8px pill track filled in ipê, a 20px thumb, a 48px tall target. */
  .seek {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-12);
    font-size: var(--text-14);
    font-variant-numeric: tabular-nums;
    color: var(--on-strong-muted);
  }
  input[type='range'] {
    --fill: linear-gradient(to right, var(--ipe) var(--seek, 0%), var(--track-on-strong) var(--seek, 0%));
    appearance: none;
    inline-size: 100%;
    min-inline-size: 0;
    block-size: 48px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-runnable-track {
    block-size: 8px;
    border-radius: var(--radius-pill);
    background: var(--fill);
  }
  input[type='range']::-moz-range-track {
    block-size: 8px;
    border-radius: var(--radius-pill);
    background: var(--fill);
  }
  input[type='range']::-webkit-slider-thumb {
    appearance: none;
    inline-size: 20px;
    block-size: 20px;
    margin-block-start: -6px;
    border: 0;
    border-radius: 50%;
    background: var(--ipe);
  }
  input[type='range']::-moz-range-thumb {
    inline-size: 20px;
    block-size: 20px;
    border: 0;
    border-radius: 50%;
    background: var(--ipe);
  }
  input[type='range']:focus-visible {
    outline-offset: -8px;
  }

  /* Speed: a pill select with a 2px currentColor border. */
  .speed {
    position: relative;
    display: inline-grid;
    align-items: center;
  }
  .speed select {
    appearance: none;
    min-block-size: 48px;
    padding: 0 34px 0 16px;
    border: 2px solid currentColor;
    border-radius: var(--radius-pill);
    background: none;
    color: inherit;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .speed option {
    color: var(--ink);
    background: var(--surface);
  }
  .speed :global(.icon) {
    position: absolute;
    inset-inline-end: 10px;
    inline-size: 18px;
    block-size: 18px;
    pointer-events: none;
  }
  .extra {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  /* ───── A · Bar and sheet ───── */
  .va {
    position: relative;
    margin-inline: var(--panel-gap);
    border-radius: var(--radius-player) var(--radius-player) 0 0;
    background: var(--strong);
    overflow: hidden;
  }
  .a-line {
    position: absolute;
    inset: 0 auto auto 0;
    inline-size: calc(var(--p, 0) * 100%);
    block-size: 3px;
    background: var(--ipe);
  }
  .a-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-8) calc(var(--space-8) + var(--player-safe-b));
  }
  .a-open {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-12);
    min-inline-size: 0;
    min-block-size: 56px;
    padding: 0 var(--space-8) 0 0;
    border: 0;
    border-radius: var(--radius-row);
    background: none;
    color: inherit;
    text-align: start;
  }
  .a-art {
    flex: none;
    inline-size: 44px;
    block-size: 44px;
    border-radius: var(--radius-row);
    background: var(--track-on-strong) var(--art, none) center / cover;
  }
  .a-text {
    display: grid;
    min-inline-size: 0;
  }
  .a-title {
    overflow: hidden;
    font-family: var(--font-serif);
    font-size: var(--text-18);
    font-weight: 700;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .a-transport {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .a-transport .play {
    inline-size: 48px;
    block-size: 48px;
  }
  .a-id,
  .a-desk {
    display: none;
  }

  .a-sheet {
    inset-block: auto 0;
    inline-size: 100%;
    max-inline-size: 100%;
    max-block-size: calc(100dvh - max(2rem, env(safe-area-inset-top)));
    margin: 0;
    padding: var(--space-8) max(var(--space-24), env(safe-area-inset-left)) calc(var(--space-32) + env(safe-area-inset-bottom));
    border: 0;
    border-radius: var(--radius-player) var(--radius-player) 0 0;
    background: var(--strong);
    color: var(--on-strong);
    text-align: center;
  }
  .a-sheet[open] {
    display: grid;
    justify-items: center;
    gap: var(--space-12);
    animation: sheet-up 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .a-sheet::backdrop {
    background: color-mix(in srgb, var(--strong) 55%, transparent);
  }
  @keyframes sheet-up {
    from {
      translate: 0 40%;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .a-sheet[open] {
      animation: none;
    }
  }
  .a-close {
    justify-self: start;
  }
  .a-big {
    inline-size: min(68vw, 18rem, 34dvh);
    block-size: auto;
    aspect-ratio: 1;
    border-radius: var(--radius-card);
    background: var(--track-on-strong) var(--art, none) center / cover;
  }
  .a-sheet-title {
    margin-block-start: var(--space-8) !important;
    font-family: var(--font-serif);
    font-size: var(--text-24);
    font-weight: 700;
    line-height: 1.15;
    text-wrap: balance;
  }
  .a-sheet-seek {
    display: grid;
    grid-template-columns: 1fr 1fr;
    inline-size: 100%;
    font-size: var(--text-14);
    font-variant-numeric: tabular-nums;
    color: var(--on-strong-muted);
  }
  .a-sheet-seek input {
    grid-column: 1 / -1;
  }
  .a-sheet-seek [data-current] {
    justify-self: start;
    margin-block-start: -10px;
  }
  .a-sheet-seek [data-duration] {
    justify-self: end;
    margin-block-start: -10px;
  }
  .a-sheet-transport {
    display: flex;
    align-items: center;
    gap: var(--space-32);
  }
  .play.big {
    inline-size: 72px;
    block-size: 72px;
  }
  .play.big :global(.icon) {
    inline-size: 30px;
    block-size: 30px;
  }
  .a-sheet-extra {
    display: flex;
    justify-content: space-between;
    inline-size: 100%;
    margin-block-start: var(--space-8);
  }

  @media (min-width: 52rem) {
    .a-row {
      display: grid;
      grid-template-columns: minmax(16rem, 1.3fr) auto minmax(14rem, 1.5fr) auto;
      gap: var(--space-24);
      padding: var(--space-12) var(--space-24) calc(var(--space-12) + var(--player-safe-b));
    }
    .a-open {
      display: none;
    }
    .a-id {
      display: flex;
      align-items: center;
      gap: var(--space-12);
      min-inline-size: 0;
    }
    .a-id .a-art {
      inline-size: 56px;
      block-size: 56px;
    }
    .a-desk {
      display: revert;
    }
    .seek.a-desk {
      display: grid;
    }
    .extra.a-desk {
      display: flex;
    }
    .a-transport .play {
      inline-size: 60px;
      block-size: 60px;
    }
    .a-id .status {
      grid-column: 1;
    }
  }
</style>
