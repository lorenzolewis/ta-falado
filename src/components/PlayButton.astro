---
// Loads its lesson into the persistent player (wired in src/lib/player-ui.ts).
import { lessonPath, type Lesson } from '../lib/lessons';
import type { Track } from '../lib/player';
import { SERIES_LABEL } from '../lib/series';

interface Props {
  lesson: Lesson;
}

const { data } = Astro.props.lesson;
const track: Track = {
  id: lessonPath(data),
  title: `${SERIES_LABEL[data.series]} ${data.number}: ${data.title}`,
  src: data.audio.url,
  durationSeconds: data.audio.durationSeconds,
  episode: data.episode,
};
---

<button type="button" data-play={JSON.stringify(track)}>Play lesson</button>
