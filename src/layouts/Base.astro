---
import { ClientRouter } from 'astro:transitions';
import Player from '../components/Player.astro';
import { OG_HEIGHT, OG_WIDTH } from '../lib/artwork';
import '../styles/base.css';

interface Props {
  /** Page title, before the site name. Omit on the home page. */
  title?: string;
  description?: string;
  /** Root-relative path of the page's Open Graph image (1200×630), e.g. from ogImagePath(). */
  ogImage?: string;
}

const { title, description = 'Brazilian Portuguese pronunciation and grammar podcast for Spanish speakers.', ogImage } = Astro.props;
if (ogImage && !Astro.site) throw new Error('Set `site` in astro.config.ts: og:image needs an absolute URL.');
const fullTitle = title ? `${title} · Tá Falado` : 'Tá Falado';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Tá Falado" />
    {
      ogImage && (
        <>
          <meta property="og:image" content={new URL(ogImage, Astro.site!).href} />
          <meta property="og:image:width" content={String(OG_WIDTH)} />
          <meta property="og:image:height" content={String(OG_HEIGHT)} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="wrap">
      <p><a href="/" lang="pt-BR">Tá Falado</a></p>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="wrap">
      <p>
        <small>
          An independent, unofficial archive. Original lessons by COERLL at the University of Texas at Austin, licensed{' '}
          <a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>.{' '}
          <a href="/about">About this site</a>
        </small>
      </p>
    </footer>
    <!-- Outside <main>, and on every page, so it is kept across navigations (ADR 0001). -->
    <Player />
  </body>
</html>
